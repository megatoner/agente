<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_jpc_ai_agent_config_multi_company" model="ir.rule">
        <field name="name">Agente IA: multi-company</field>
        <field name="model_id" ref="model_jpc_ai_agent_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_jpc_ai_agent_session_own" model="ir.rule">
        <field name="name">Sesión IA: propia o admin</field>
        <field name="model_id" ref="model_jpc_ai_agent_session"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_jpc_ai_agent_message_session" model="ir.rule">
        <field name="name">Mensaje IA: por sesión propia</field>
        <field name="model_id" ref="model_jpc_ai_agent_message"/>
        <field name="domain_force">['|', ('session_id.user_id', '=', user.id), ('session_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
