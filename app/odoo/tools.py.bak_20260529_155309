                f"Email: {p.get('email','N/A')}\nCiudad: {p.get('city','N/A')}\n"
                f"Deuda pendiente: {_fmt_currency(p.get('debit',0))}\n"
                f"A favor (crédito): {_fmt_currency(p.get('credit',0))}")

