<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jpc_ai_agents" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jpc.ai.agents</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="after">
                <block title="Servidor de Agentes IA" name="agent_server_setting">
                    <setting string="Conexión al Servidor" help="Configura la URL y API Key del servidor de agentes externo.">
                        <div class="content-group">
                            <div class="mt16">
                                <label for="agent_server_url" string="URL" class="o_form_label col-3"/>
                                <field name="agent_server_url" class="oe_inline"/>
                            </div>
                            <div class="mt8">
                                <label for="agent_server_api_key" string="API Key" class="o_form_label col-3"/>
                                <field name="agent_server_api_key" class="oe_inline" password="1"/>
                            </div>
                            <div class="mt8">
                                <button name="test_agent_connection" type="object" string="Probar Conexión" class="btn btn-primary"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
