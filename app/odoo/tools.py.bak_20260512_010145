    }

    def _get_stop_words() -> set:
        bot_id = (odoo_context or {}).get("bot_id")
        if bot_id:
            try:
                rec = odoo.read("jpc.whatsapp.bot.config", [bot_id], ["printer_stop_words"])
                raw = (rec or [{}])[0].get("printer_stop_words") or ""
                if raw.strip():
                    return {w.strip().lower() for w in raw.splitlines() if len(w.strip()) > 1}
            except Exception:
                pass
        return set(_CONSUMABLE_STOP_DEFAULT)

    def _buscar_por_atributo_impresora(termino: str) -> list:
        """Busca IDs de product.product cuyo atributo 'Impresoras Compatibles' coincide."""
        try:
            attr_vals = odoo.search_read(
                "product.attribute.value",
                [("attribute_id", "=", _ATTR_COMPAT_IMPRESORA),
                 ("name", "ilike", termino)],
                ["id"], 30
            )
            if not attr_vals:
                return []
            av_ids = [v["id"] for v in attr_vals]
            ptavs = odoo.search_read(
                "product.template.attribute.value",
                [("product_attribute_value_id", "in", av_ids)],
                ["product_tmpl_id"], 50
            )
            if not ptavs:
                return []
            tmpl_ids = list({p["product_tmpl_id"][0] for p in ptavs if p.get("product_tmpl_id")})
            prods = odoo.search_read(
                "product.product",
                [("product_tmpl_id", "in", tmpl_ids),
                 ("sale_ok", "=", True),
                 ("active", "=", True),
                 ("qty_available", ">", 0)],
                ["id", "name", "default_code", "qty_available"], 6
            )
            return prods
        except Exception as e:
            logger.warning("_buscar_por_atributo_impresora: %s", e)
            return []

    def _buscar_por_sku_oem(referencia: str) -> list:
        """Busca productos por atributo 'Sku OEM' (referencia de cartucho)."""
        try:
            attr_vals = odoo.search_read(
                "product.attribute.value",
                [("attribute_id", "=", _ATTR_SKU_OEM),
                 ("name", "ilike", referencia)],
                ["id"], 10
            )
            if not attr_vals:
                return []
            av_ids = [v["id"] for v in attr_vals]
            ptavs = odoo.search_read(
                "product.template.attribute.value",
                [("product_attribute_value_id", "in", av_ids)],
                ["product_tmpl_id"], 20
            )
            if not ptavs:
                return []
            tmpl_ids = list({p["product_tmpl_id"][0] for p in ptavs if p.get("product_tmpl_id")})
            prods = odoo.search_read(
                "product.product",
                [("product_tmpl_id", "in", tmpl_ids),
                 ("sale_ok", "=", True),
                 ("active", "=", True),
                 ("qty_available", ">", 0)],
                ["id", "name", "default_code", "qty_available"], 6
            )
            return prods
        except Exception as e:
            logger.warning("_buscar_por_sku_oem: %s", e)
            return []

    @tool
    def buscar_producto(referencia: str) -> str:
        """Buscar productos en el catálogo por referencia de cartucho o modelo de impresora.

        Úsala UNA VEZ POR CADA referencia o modelo que el cliente mencione.
        Ejemplos:
          buscar_producto("HP LaserJet M1132")
          buscar_producto("HP Laser MFP 135w")
          buscar_producto("CE285A")
          buscar_producto("85A")
          buscar_producto("Canon MG3010")

        La búsqueda usa SOLO atributos configurados (Impresoras Compatibles, SKU OEM,
        Referencia interna). NO busca por texto libre — esto garantiza resultados correctos.

        Esta herramienta envía automáticamente las tarjetas al cliente.
        NO necesitas hacer nada más después de llamarla.
        """
        prods = []
        bot_id = (odoo_context or {}).get("bot_id")

        # Paso 1: buscar vía método Odoo (usa atributos configurados del bot)
        if bot_id:
            try:
                ids = odoo.execute_kw(
                    "jpc.whatsapp.bot.config", "buscar_para_agente",
                    [[bot_id], referencia],
                )
                if ids:
                    prods = odoo.read(
                        "product.product", ids,
                        ["id", "name", "default_code", "qty_available"],
                    )
            except Exception as e:
                logger.warning("buscar_producto: buscar_para_agente error: %s", e)

        # Paso 2: fallback local por atributos (sin bot_id o si Odoo no responde)
        if not prods:
            prods = _buscar_por_atributo_impresora(referencia)
        if not prods:
            prods = _buscar_por_sku_oem(referencia)

        if not prods:
            return (
                f"No encontré productos con stock para '{referencia}'.\n"
                f"Pídele al cliente la referencia exacta del cartucho "
                f"(ej: Q2612A, 85A, CE285A) o el modelo exacto de impresora."
            )

        ids = [p["id"] for p in prods]
        logger.info("buscar_producto: '%s' → IDs=%s", referencia, ids)

        tarjeta_result = _enviar_tarjetas_auto(ids, max_cards=3)

        lines = [f"Encontré {len(prods)} producto(s) para '{referencia}'."]
        for p in prods:
            qty = p.get("qty_available", 0)
            stock_txt = f" | Stock:{qty:.0f}" if qty is not None else ""
            lines.append(f"  - {p.get('name', '')} | Ref:{p.get('default_code', 'N/A')}{stock_txt}")
        lines.append(tarjeta_result)
        return "\n".join(lines)

    # ── COTIZACIONES ──────────────────────────────────────────────────────

    @tool
    def crear_cotizacion(partner_id: int, nota: str = "") -> str:
        """Crear una nueva cotización para un cliente. Retorna ID y nombre."""
        vals = {
            "partner_id": partner_id,
            "state": "draft",
            "payment_method_id": 215,
        }
        if nota:
            vals["note"] = nota
        new_id = odoo.create("sale.order", vals)
        recs = odoo.read("sale.order", [new_id], ["name"])
        name = recs[0]["name"] if recs else str(new_id)
        return f"Cotización creada: {name} (ID:{new_id})"

    @tool
    def agregar_linea_cotizacion(order_id: int, product_id: int, cantidad: float = 1.0) -> str:
        """Agregar un producto a una cotización existente."""
        prods = odoo.read("product.product", [product_id], ["name","list_price"])
        if not prods:
            return f"Producto {product_id} no encontrado."
        price = prods[0].get("list_price", 0)
        odoo.create("sale.order.line", {
            "order_id": order_id, "product_id": product_id,
            "product_uom_qty": cantidad, "price_unit": price,
        })
        return (f"✅ Agregado: {prods[0]['name']} × {cantidad:.0f} = "
                f"{_fmt_currency(price * cantidad)}")

    @tool
    def obtener_cotizacion(order_id: int) -> str:
        """Obtener detalles de una cotización: cliente, estado, líneas, total."""
        recs = odoo.read("sale.order", [order_id],
                         ["name","partner_id","state","amount_total","date_order","order_line"])
        if not recs:
            return f"Cotización {order_id} no encontrada."
        o = recs[0]
        state_map = {"draft":"Borrador","sent":"Enviada","sale":"Confirmada",
                     "cancel":"Cancelada","done":"Finalizada"}
        lines_text = ""
        if o.get("order_line"):
            lines = odoo.read("sale.order.line", o["order_line"],
                              ["product_id","product_uom_qty","price_unit","price_subtotal"])
            items = [f"  • {_m2o(l.get('product_id'))} × {l.get('product_uom_qty',0):.0f} = "
                     f"{_fmt_currency(l.get('price_subtotal',0))}" for l in lines]
            lines_text = "\nProductos:\n" + "\n".join(items)
        return (f"Cotización: {o.get('name')}\nCliente: {_m2o(o.get('partner_id'))}\n"
                f"Estado: {state_map.get(o.get('state',''), o.get('state',''))}\n"
                f"Fecha: {_fmt_date(str(o.get('date_order','') or ''))}\n"
                f"Total: {_fmt_currency(o.get('amount_total',0))}{lines_text}")

    @tool
    def confirmar_orden(order_id: int) -> str:
        """Confirmar una cotización y convertirla en pedido de venta."""
        try:
            odoo.execute_kw("sale.order", "action_confirm", [[order_id]])
            recs = odoo.read("sale.order", [order_id], ["name"])
            name = recs[0]["name"] if recs else str(order_id)
            return f"✅ Orden {name} confirmada."
        except Exception as e:
            return f"Error al confirmar: {str(e)}"

