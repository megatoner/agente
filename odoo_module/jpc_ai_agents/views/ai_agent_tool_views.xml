<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jpc_ai_agent_tool_tree" model="ir.ui.view">
        <field name="name">jpc.ai.agent.tool.tree</field>
        <field name="model">jpc.ai.agent.tool</field>
        <field name="arch" type="xml">
            <tree string="Tools IA" editable="bottom">
                <field name="name"/>
                <field name="display_name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_jpc_ai_agent_tool_form" model="ir.ui.view">
        <field name="name">jpc.ai.agent.tool.form</field>
        <field name="model">jpc.ai.agent.tool</field>
        <field name="arch" type="xml">
            <form string="Tool IA">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="display_name"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="Descripción de lo que hace esta tool..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jpc_ai_agent_tool" model="ir.actions.act_window">
        <field name="name">Tools IA</field>
        <field name="res_model">jpc.ai.agent.tool</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
