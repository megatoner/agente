    @tool
    def ver_carrito() -> str:
        """Ver el estado actual del carrito de compras: productos buscados, precios mostrados y líneas cotizadas.
        Llama esta herramienta cuando necesites saber qué productos ya están en el carrito antes de actuar."""
        if not ch_id:
